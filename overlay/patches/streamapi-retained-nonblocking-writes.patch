diff --git a/src/mesh/StreamFrameWriter.cpp b/src/mesh/StreamFrameWriter.cpp
new file mode 100644
index 000000000..0a4a50b0d
--- /dev/null
+++ b/src/mesh/StreamFrameWriter.cpp
@@ -0,0 +1,72 @@
+#include "StreamFrameWriter.h"
+
+#include <cassert>
+
+bool StreamFrameWriter::writeFrame(Stream &stream, uint8_t *frame, size_t frameLen, bool bestEffort)
+{
+    if (!finishPendingFrame(stream)) {
+        // writeStream() gates the single required-frame producer on
+        // finishPendingFrame(), so a second required frame cannot arrive here.
+        assert(bestEffort || !deferredFrame);
+
+        if (!bestEffort && !deferredFrame) {
+            deferredFrame = frame;
+            deferredFrameLen = frameLen;
+        }
+        return false;
+    }
+
+    // Never start best-effort output unless the transport is writable now.
+    if (bestEffort && stream.availableForWrite() < (int)frameLen)
+        return false;
+
+    size_t written = stream.write(frame, frameLen);
+    if (written > frameLen)
+        written = frameLen;
+    if (written == frameLen)
+        return true;
+
+    pendingFrame = frame;
+    pendingFrameLen = frameLen;
+    pendingFrameOffset = written;
+    return false;
+}
+
+bool StreamFrameWriter::finishPendingFrame(Stream &stream)
+{
+    if (!pendingFrame)
+        return true;
+
+    size_t remaining = pendingFrameLen - pendingFrameOffset;
+    size_t written = stream.write(pendingFrame + pendingFrameOffset, remaining);
+    if (written > remaining)
+        written = remaining;
+    pendingFrameOffset += written;
+
+    if (pendingFrameOffset < pendingFrameLen)
+        return false;
+
+    pendingFrame = nullptr;
+    pendingFrameLen = 0;
+    pendingFrameOffset = 0;
+
+    // Promote required output without starting another write in this call.
+    if (deferredFrame) {
+        pendingFrame = deferredFrame;
+        pendingFrameLen = deferredFrameLen;
+        deferredFrame = nullptr;
+        deferredFrameLen = 0;
+        return false;
+    }
+
+    return true;
+}
+
+void StreamFrameWriter::reset()
+{
+    pendingFrame = nullptr;
+    pendingFrameLen = 0;
+    pendingFrameOffset = 0;
+    deferredFrame = nullptr;
+    deferredFrameLen = 0;
+}
diff --git a/src/mesh/StreamFrameWriter.h b/src/mesh/StreamFrameWriter.h
new file mode 100644
index 000000000..59f586c0a
--- /dev/null
+++ b/src/mesh/StreamFrameWriter.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include "Stream.h"
+#include <cstddef>
+#include <cstdint>
+
+/** Caller-owned frame storage must remain valid and unchanged until isIdle(). */
+class StreamFrameWriter
+{
+  public:
+    /// Start a complete frame, or retain a required frame behind pending output.
+    bool writeFrame(Stream &stream, uint8_t *frame, size_t frameLen, bool bestEffort);
+
+    /// Make one bounded attempt to finish pending output.
+    bool finishPendingFrame(Stream &stream);
+
+    /// Return true when no frame buffer is retained.
+    bool isIdle() const { return pendingFrame == nullptr && deferredFrame == nullptr; }
+
+    /// Forget retained bytes when their physical transport session is gone.
+    void reset();
+
+  private:
+    uint8_t *pendingFrame = nullptr;
+    size_t pendingFrameLen = 0;
+    size_t pendingFrameOffset = 0;
+    uint8_t *deferredFrame = nullptr;
+    size_t deferredFrameLen = 0;
+};
diff --git a/src/mesh/UsbSessionStream.h b/src/mesh/UsbSessionStream.h
new file mode 100644
index 000000000..c360c60f0
--- /dev/null
+++ b/src/mesh/UsbSessionStream.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "HWCDC.h"
+#include "Stream.h"
+
+/** Prevent stock HWCDC's disconnected FIFO policy from accepting/dropping a
+ * frame while the cable is absent or its internal CDC state is recovering
+ * from backpressure. */
+class UsbSessionStream : public Stream
+{
+  public:
+    explicit UsbSessionStream(Stream &_delegate) : delegate(_delegate) {}
+
+    int available() override { return delegate.available(); }
+    int read() override { return delegate.read(); }
+    int peek() override { return delegate.peek(); }
+    void flush() override { delegate.flush(); }
+    size_t write(uint8_t value) override { return write(&value, 1); }
+    size_t write(const uint8_t *buffer, size_t size) override
+    {
+        // Stock Arduino-ESP32 HWCDC::write() reports the full size while its
+        // internal `connected` flag is false, even though it drops the bytes.
+        // isConnected() also arms the IN_EMPTY interrupt so a draining host
+        // can recover that flag; retain the frame until it does.
+        if (!canTransmit())
+            return 0;
+
+        // Never ask stock HWCDC to wait for more ring space. Its timeout path
+        // can mark CDC disconnected after enqueuing a prefix and then report a
+        // short write with destructive FIFO semantics. Limiting the call to
+        // the space already available makes that internal tail path
+        // unreachable; StreamFrameWriter retains our remaining bytes instead.
+        const int available = delegate.availableForWrite();
+        if (available <= 0)
+            return 0;
+        const size_t chunk = size < static_cast<size_t>(available) ? size : static_cast<size_t>(available);
+        return delegate.write(buffer, chunk);
+    }
+    int availableForWrite() override { return canTransmit() ? delegate.availableForWrite() : 0; }
+
+  private:
+    static bool canTransmit() { return HWCDC::isPlugged() && HWCDC::isConnected(); }
+
+    Stream &delegate;
+};
