+void SerialConsole::onConnectionChanged(bool connected)
+{
+    if (!connected) {
+        setHostDraining(false);
+        // Keep any disconnect-side logs inside the old framed session, then
+        // discard every byte and pointer belonging to that session.
+        StreamAPI::onConnectionChanged(false);
+#ifdef IS_USB_SERIAL
+        // A retained tail belongs to the old physical session. Clear both its
+        // metadata and HWCDC's queued prefix before a new wantConfig can start.
+        // Disable framed writes under the same lock first: a concurrent LOG_
+        // that passed its optimistic admission check must not enqueue stale
+        // bytes between reset() and flush().
+        {
+            concurrency::LockGuard guard(&streamLock);
+            canWrite = false;
+            frameWriter.reset();
+            Port.setTxTimeoutMs(50);
+            Port.flush();
+            Port.setTxTimeoutMs(1);
+
+            resetStreamInput();
+            if (!HWCDC::isPlugged()) {
+                int unread = Port.available();
+                while (unread-- > 0)
