 #include "main.h"
 #include "sleep.h"
 #include <memory>
+#include <new>
 
 #ifdef HAS_I2S
 #include <AudioFileSourcePROGMEM.h>
@@ -26,13 +27,23 @@ class AudioThread : public concurrency::OSThread
 
     void beginRttl(const void *data, uint32_t len)
     {
+        if (i2sRtttl || rtttlFile)
+            stop();
+        if (!data || !len || !audioOut)
+            return;
 #ifdef T_LORA_PAGER
         io.digitalWrite(EXPANDS_AMP_EN, HIGH);
