+#ifdef ARCH_ESP32
+size_t NonBlockingWiFiStream::write(const uint8_t *buffer, size_t size)
+{
+    if (fatalWrite || !client.connected() || client.fd() < 0) {
+        fatalWrite = true;
+        return 0;
+    }
+
+    const int result = ::send(client.fd(), buffer, size, MSG_DONTWAIT);
+    if (result > 0)
+        return static_cast<size_t>(result);
+    if (result < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR))
+        return 0;
+
+    fatalWrite = true;
+    return 0;
+}
+
+int NonBlockingWiFiStream::availableForWrite()
+{
+    if (fatalWrite || !client.connected() || client.fd() < 0)
+        return 0;
+
+    fd_set writeSet;
+    FD_ZERO(&writeSet);
+    FD_SET(client.fd(), &writeSet);
+    timeval timeout = {0, 0};
+    const int result = select(client.fd() + 1, nullptr, &writeSet, nullptr, &timeout);
+    if (result > 0 && FD_ISSET(client.fd(), &writeSet))
+        return INT_MAX;
+    if (result < 0 && errno != EINTR)
+        fatalWrite = true;
+    return 0;
+}
+
+WiFiServerAPI::WiFiServerAPI(WiFiClient &_client) : ServerAPI(_client), nonBlockingStream(client)
+{
+    api_type = TYPE_WIFI;
+    LOG_INFO("Incoming wifi connection");
+}
+
+bool WiFiServerAPI::handleFatalWrite()
+{
+    if (!nonBlockingStream.failed())
+        return false;
+
+    canWrite = false;
+    LOG_WARN("TCP socket write failed, closing API service");
+    ServerAPI<WiFiClient>::close();
+    return true;
+}
+
+bool WiFiServerAPI::finishPendingFrame()
+{
+    concurrency::LockGuard guard(&streamLock);
+    const bool complete = frameWriter.finishPendingFrame(nonBlockingStream);
+    return handleFatalWrite() ? false : complete;
+}
+
+bool WiFiServerAPI::hasRetainedFrame()
