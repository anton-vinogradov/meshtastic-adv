+            // The constructor and Say() both allocate synthesis state internally.
+        }
         setCPUFast(false);
 #ifdef T_LORA_PAGER
         io.digitalWrite(EXPANDS_AMP_EN, LOW);
@@ -91,7 +107,14 @@ class AudioThread : public concurrency::OSThread
