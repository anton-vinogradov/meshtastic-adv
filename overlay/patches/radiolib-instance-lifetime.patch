+RadioLibInterface::~RadioLibInterface()
+{
+    // advui-inject-radio-instance-lifetime: failed hardware probes are deleted.
+    // The main-loop poll must not keep a pointer to a freed radio. An older
+    // probe must not clear the singleton belonging to a newer live instance.
+    if (instance == this)
+        instance = nullptr;
+}
