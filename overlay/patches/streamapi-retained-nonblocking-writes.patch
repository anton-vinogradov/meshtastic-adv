+{
+#ifdef IS_USB_SERIAL
+    // Arduino-ESP32 2.0.17 underflows HWCDC's retry counter at exactly zero.
+    // One millisecond is the minimum safe dead-host bound; while an API host
+    // is alive, retained frames get a still-bounded opportunity to drain.
